# Copier en .env (chmod 600) sur le VPS. Ne jamais commiter .env.
RESEND_API_KEY=
MAIL_TO=contact@syntonie.be
MAIL_FROM=Inscriptions Syntonie <inscription@syntonie.be>
# 1 = bandeau TEST sur la page et [TEST] dans l'objet des e-mails
TEST_MODE=1
# Code d'accueil, donné sur place par un·e bénévole. Sans lui la fiche est
# refusée. Vide = fiche ouverte à tous (déconseillé). À changer de temps en temps.
ACCESS_CODE=
# Citizen Pay : lieu qui reçoit la cotisation (id ou slug). Vide = pas de
# Citizen Pay, virement et accueil seulement. TEST_MODE ne change rien ici :
# pour ne pas payer pour de vrai, pointer l'API vers l'environnement de test
# (https://api2.staging.citizenpay.eu).
CITIZENPAY_PLACE=
CITIZENPAY_API_URL=https://api2.citizenpay.xyz
# Cotisation en centimes. Doit valoir FEE dans www/index.html.
FEE_CENTS=2500
